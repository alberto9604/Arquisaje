main_js = """// main.js - carga datos desde archivos JSON y maneja interacciones
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('year').textContent = new Date().getFullYear();
  // Load services (hardcoded for easy editing)
  const services = [
    { icon: '🏛️', title: 'Diseño Interior', desc: 'Planos y propuestas de diseño funcionales y estéticos.' },
    { icon: '🏗️', title: 'Diseño Exterior', desc: 'Fachadas y soluciones exteriores con enfoque en durabilidad.' },
    { icon: '🖥️', title: 'Renderizado 3D', desc: 'Visualizaciones realistas para presentar propuestas.' },
    { icon: '🔧', title: 'Instalación WPC', desc: 'Instalación de paneles WPC y acabados exteriores.' },
    { icon: '🧭', title: 'Consultoría de espacio', desc: 'Asesoría para optimizar espacios y materiales.' },
    { icon: '🎨', title: 'Pintura y Acabados', desc: 'Aplicación de pintura, acabados y detalles finales.' }
  ];
  const sg = document.getElementById('services-grid');
  services.forEach(s => {
    const card = document.createElement('div');
    card.className = 'card';
    card.innerHTML = `<h3>${s.icon} ${s.title}</h3><p>${s.desc}</p>`;
    sg.appendChild(card);
  });

  // Load projects from JSON
  fetch('data-proyectos.json').then(r=>r.json()).then(data=>{
    const pg = document.getElementById('projects-grid');
    data.forEach(p=>{
      const card = document.createElement('div');
      card.className = 'card';
      card.innerHTML = `<img class="project-img" src="${p.imagen}" alt="${p.titulo}" />
        <h3>${p.titulo}</h3>
        <p class="muted">${p.area} — ${p.fecha}</p>
        <p>${p.descripcion}</p>
        <p><strong>Materiales:</strong> ${p.materiales.join(', ')}</p>
        <a class="btn" href="${p.link || '#'}" target="_blank">Ver más</a>`;
      pg.appendChild(card);
    });
  }).catch(err=>{
    console.warn('No se pudo cargar data-proyectos.json', err);
  });

  // Load reviews
  fetch('data-reseñas.json').then(r=>r.json()).then(data=>{
    const rl = document.getElementById('reviews-list');
    data.forEach(rv=>{
      const div = document.createElement('div');
      div.className = 'card review';
      let stars = '★'.repeat(rv.estrellas) + '☆'.repeat(5 - rv.estrellas);
      div.innerHTML = `<div><strong>${rv.nombre}</strong><div class="stars">${stars}</div></div><div style="flex:1"><p>${rv.comentario}</p></div>`;
      rl.appendChild(div);
    });
  }).catch(err=>{
    console.warn('No se pudo cargar data-reseñas.json', err);
  });

  // Mobile nav toggle
  const toggle = document.querySelector('.nav-toggle');
  toggle?.addEventListener('click', ()=> {
    const nav = document.querySelector('.nav');
    if(nav.style.display === 'flex') nav.style.display = 'none';
    else nav.style.display = 'flex';
  });
});

// Contact form handler: open mailto to the provided company email (editable)
function handleContactSubmit(e){
  e.preventDefault();
  const name = document.getElementById('name').value.trim();
  const email = document.getElementById('email').value.trim();
  const phone = document.getElementById('phone').value.trim();
  const message = document.getElementById('message').value.trim();
  const subject = encodeURIComponent('Contacto desde sitio web — ' + name);
  const body = encodeURIComponent(`Nombre: ${name}%0ACorreo: ${email}%0ATeléfono: ${phone}%0A%0AMensaje:%0A${message}`);
  // Change this email if you prefer a different destination
  const to = 'arquisajecoporation@gmail.com';
  window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
  return false;
}
"""

